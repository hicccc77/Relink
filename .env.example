# Model configuration for the complete model-led Agent. Data-only CLI commands do not need these values.
RELINK_MODEL_PROTOCOL=openai-compatible
RELINK_MODEL_PROVIDER=openai-compatible
RELINK_MODEL_BASE_URL=https://api.openai.com/v1
RELINK_MODEL_API_KEY=
RELINK_MODEL=gpt-4o-mini
RELINK_HOST=127.0.0.1
RELINK_PORT=8787
